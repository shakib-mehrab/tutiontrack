// Firestore Security Rules for TuitionTrack
//
// All reads and writes go through the Next.js API routes, which use the Firebase Admin SDK.
// The Admin SDK bypasses these rules, and every route checks ownership itself
// (see src/lib/access.ts). The browser never talks to Firestore directly, so clients
// get no access at all. This also keeps OTP hashes and other users' data unreadable.
//
// Deploy with:  firebase deploy --only firestore:rules
//
// If you later add client-side realtime listeners, open up only the specific
// collections they need, scoped to request.auth.uid (and sign users in to Firebase Auth
// on the client with a custom token so request.auth is set).

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
